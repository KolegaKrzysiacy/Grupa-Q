y = "Liczba kategorii"
) +
theme_classic()
df_top <- df10 %>%
arrange(desc(liczba_widzow)) %>%
slice_head(n = 10)
ggplot(df_top, aes(x = reorder(nazwa_kategorii, liczba_widzow),
y = liczba_widzow)) +
geom_col() +
coord_flip() +
labs(
title = "Top 10 kategorii pod względem liczby widzów",
x = "Kategoria",
y = "Liczba widzów"
) +
theme_classic()
